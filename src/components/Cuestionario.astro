---
import type { PreguntaCuestionario } from '@/types/quiz';
import PixelSprite from '@/components/PixelSprite.astro';
import { serializarParaScript } from '@/utils/serializar';

interface Props {
  preguntas: PreguntaCuestionario[];
  /** Muestra la unidad de cada pregunta (útil en el modo con todas las unidades mezcladas). */
  mostrarUnidad: boolean;
  /** Permite repasar solo las unidades elegidas en la URL (`?unidades=2&unidades=3`). */
  permiteSeleccion?: boolean;
}

const { preguntas, mostrarUnidad, permiteSeleccion = false } = Astro.props;
---

<div
  data-cuestionario
  data-mostrar-unidad={mostrarUnidad ? 'si' : 'no'}
  data-permite-seleccion={permiteSeleccion ? 'si' : 'no'}
  class="mt-6"
>
  <script is:inline type="application/json" data-preguntas set:html={serializarParaScript(preguntas)}></script>

  <noscript>
    <p class="caja-pixel bg-aviso-suave p-4">El cuestionario necesita JavaScript habilitado.</p>
  </noscript>

  <!-- Progreso: un segmento por pregunta, coloreado según el resultado -->
  <div data-zona-progreso class="hidden">
    <div class="flex items-center justify-between gap-3 text-sm">
      <p data-progreso class="font-pixel text-base text-tinta"></p>
      <p data-puntaje class="text-tenue"></p>
    </div>
    <div
      data-segmentos
      class="mt-2 flex h-5 gap-[3px] border-[3px] border-borde bg-panel p-[3px]"
      role="progressbar"
      aria-label="Progreso del cuestionario"
      aria-valuemin="0"
    >
    </div>
  </div>

  <!-- Pregunta -->
  <section data-vista-pregunta class="mt-6 hidden">
    <article class="caja-pixel bg-panel">
      <p data-etiqueta class="border-b-[3px] border-borde bg-panel-2 px-4 py-2 text-xs uppercase tracking-wide text-primario sm:px-6"></p>
      <div class="p-4 sm:p-6">
        <h2
          data-enunciado
          tabindex="-1"
          class="font-sans text-base font-semibold leading-relaxed text-tinta wrap-anywhere focus:outline-none sm:text-lg"
        >
        </h2>
        <ol data-opciones class="mt-5 space-y-3"></ol>
      </div>
    </article>

    <div data-retro class="caja-pixel mt-5 hidden" aria-live="polite">
      <p data-retro-estado class="border-b-[3px] px-4 py-2 text-xs font-bold sm:px-6"></p>
      <div class="p-4 sm:p-6">
        <p data-retro-titulo class="font-pixel text-2xl font-bold"></p>
        <div data-retro-cuerpo class="mt-3 space-y-4 text-tinta"></div>
        <div class="mt-5 border-t-[3px] border-dashed border-borde/50 pt-4">
          <p class="font-pixel text-base font-semibold text-tinta">Material de estudio</p>
          <ul data-retro-enlaces class="mt-2 space-y-1"></ul>
        </div>
      </div>
    </div>

    <!-- Navegación entre preguntas -->
    <div class="mt-5 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
      <button type="button" data-anterior class="boton-pixel w-full bg-panel text-tinta sm:w-auto">◀ Anterior</button>
      <button type="button" data-siguiente class="boton-pixel hidden w-full bg-primario text-sobre-primario sm:ml-auto sm:w-auto"></button>
    </div>
  </section>

  <!-- Resultado -->
  <section data-vista-resultado class="mt-6 hidden">
    <div class="caja-pixel bg-panel p-6 text-center shadow-pixel-lg sm:p-8">
      <PixelSprite nombre="trofeo" escala={6} class="mx-auto" />
      <h2 data-resultado-titulo tabindex="-1" class="mt-4 text-2xl font-bold text-tinta focus:outline-none sm:text-3xl">
        Resultado
      </h2>
      <p data-resultado-puntaje class="mt-2 font-pixel text-5xl font-bold text-primario sm:text-6xl"></p>
      <p data-resultado-porcentaje class="mt-2 text-sm text-tenue"></p>
      <p data-resultado-mensaje class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-tinta"></p>
      <div class="mt-6 flex flex-col justify-center gap-4 sm:flex-row">
        <button type="button" data-reintentar class="boton-pixel bg-primario text-sobre-primario">↻ Reintentar</button>
        <a href="/" class="boton-pixel bg-panel text-tinta">Volver al inicio</a>
      </div>
    </div>

    <div data-repaso class="mt-8 hidden">
      <h3 class="text-xl font-bold text-tinta">
        <span class="font-sans text-base font-normal text-tenue">--</span> Para repasar
      </h3>
      <p class="mt-1 text-sm text-tenue">Preguntas que respondiste de forma incorrecta y su material.</p>
      <ul data-repaso-lista class="mt-4 space-y-4"></ul>
    </div>
  </section>
</div>

<script>
  import { iniciarCuestionario } from '@/scripts/cuestionario';

  document.querySelectorAll<HTMLElement>('[data-cuestionario]').forEach(iniciarCuestionario);
</script>
