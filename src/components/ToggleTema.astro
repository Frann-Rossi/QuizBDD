---
/**
 * Selector de tema con dos opciones: Claro y Oscuro.
 * Sin preferencia guardada, el tema inicial lo decide el sistema (ver script en BaseLayout).
 */
const opciones = [
  { valor: 'claro', icono: '☀', texto: 'Claro' },
  { valor: 'oscuro', icono: '☾', texto: 'Oscuro' },
] as const;
---

<div data-selector-tema role="group" aria-label="Tema" class="flex border-[3px] border-borde shadow-[3px_3px_0_0_var(--sombra)]">
  {
    opciones.map((opcion, i) => (
      <button
        type="button"
        data-tema-opcion={opcion.valor}
        aria-pressed="false"
        aria-label={`Tema ${opcion.texto.toLowerCase()}`}
        class:list={[
          'flex items-center gap-1 bg-panel px-2 py-1 font-pixel text-base uppercase text-tenue transition-colors hover:text-tinta aria-pressed:bg-primario aria-pressed:text-sobre-primario sm:px-3',
          i > 0 && 'border-l-[3px] border-borde',
        ]}
      >
        <span aria-hidden="true">{opcion.icono}</span>
        <span class="hidden sm:inline">{opcion.texto}</span>
      </button>
    ))
  }
</div>

<script>
  const CLAVE = 'quiz-bdd:tema';
  type Tema = 'claro' | 'oscuro';

  function temaActual(): Tema {
    return document.documentElement.dataset['tema'] === 'oscuro' ? 'oscuro' : 'claro';
  }

  function marcar(tema: Tema): void {
    document.querySelectorAll<HTMLButtonElement>('[data-tema-opcion]').forEach((boton) => {
      boton.setAttribute('aria-pressed', String(boton.dataset['temaOpcion'] === tema));
    });
  }

  function aplicar(tema: Tema): void {
    document.documentElement.dataset['tema'] = tema;
    try {
      localStorage.setItem(CLAVE, tema);
    } catch {
      // Sin almacenamiento: el tema se aplica igual durante esta visita.
    }
    marcar(tema);
  }

  marcar(temaActual());

  document.querySelectorAll<HTMLButtonElement>('[data-tema-opcion]').forEach((boton) => {
    boton.addEventListener('click', () => aplicar(boton.dataset['temaOpcion'] === 'oscuro' ? 'oscuro' : 'claro'));
  });
</script>
