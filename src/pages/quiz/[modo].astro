---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Cuestionario from '@/components/Cuestionario.astro';
import { aPreguntasCuestionario } from '@/lib/quiz/cuestionario';
import { obtenerBancosPreguntas } from '@/services/preguntas';
import { formatearUnidad } from '@/utils/formato';
import { MODO_TODAS, modoUnidad } from '@/utils/rutas';

export const getStaticPaths = (async () => {
  const bancos = await obtenerBancosPreguntas();

  return [
    {
      params: { modo: MODO_TODAS },
      props: {
        titulo: 'Todas las unidades',
        subtitulo: 'Preguntas mezcladas',
        consulta: 'quiz',
        preguntas: bancos.flatMap(aPreguntasCuestionario),
        mostrarUnidad: true,
      },
    },
    ...bancos.map((banco) => ({
      params: { modo: modoUnidad(banco.unidad) },
      props: {
        titulo: banco.titulo,
        subtitulo: formatearUnidad(banco.unidad),
        consulta: `unidad_${String(banco.unidad).padStart(2, '0')}`,
        preguntas: aPreguntasCuestionario(banco),
        mostrarUnidad: false,
      },
    })),
  ];
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { titulo, subtitulo, consulta, preguntas, mostrarUnidad } = Astro.props;
---

<BaseLayout title={`${titulo} · Quiz BDD`}>
  <main class="mx-auto max-w-3xl px-4 py-6 sm:px-6 sm:py-10">
    <a href="/" class="font-pixel text-sm uppercase text-tenue hover:text-tinta">◀ Volver al inicio</a>

    <header class="mt-4">
      <p class="text-xs text-tenue">
        <span class="text-ok">mysql&gt;</span>{' '}<span class="font-bold text-sql-clave">SELECT</span>{' * '}<span class="font-bold text-sql-clave">FROM</span>{` ${consulta};`}
      </p>
      <h1 id="titulo-cuestionario" class="mt-2 text-3xl font-bold text-tinta sm:text-4xl">{titulo}</h1>
      <p id="subtitulo-cuestionario" class="mt-1 text-sm uppercase tracking-widest text-primario">{subtitulo}</p>
    </header>

    <Cuestionario preguntas={preguntas} mostrarUnidad={mostrarUnidad} permiteSeleccion={mostrarUnidad} />
  </main>
</BaseLayout>

<script>
  // En el modo mezclado con unidades elegidas (?unidades=…), el título refleja la selección.
  import { etiquetaUnidades, filtrarPorUnidades, unidadesDesdeBusqueda } from '@/lib/quiz/seleccion';

  const raiz = document.querySelector<HTMLElement>('[data-cuestionario]');
  const seleccion = raiz?.dataset['permiteSeleccion'] === 'si' ? unidadesDesdeBusqueda(window.location.search) : null;
  const banco = JSON.parse(raiz?.querySelector('[data-preguntas]')?.textContent ?? '[]');
  // Solo se muestra la selección si realmente hay preguntas de esas unidades (igual que en el cuestionario).
  const unidades = seleccion && filtrarPorUnidades(banco, seleccion).length > 0 ? seleccion : null;
  if (unidades) {
    const titulo = document.getElementById('titulo-cuestionario');
    const subtitulo = document.getElementById('subtitulo-cuestionario');
    if (titulo) titulo.textContent = etiquetaUnidades(unidades);
    if (subtitulo) subtitulo.textContent = 'Selección de unidades';
  }
</script>
