---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CabeceraPagina from '@/components/CabeceraPagina.astro';
import VolverInicio from '@/components/VolverInicio.astro';
import { obtenerDocumentosMaterial } from '@/services/material';
import { serializarParaScript } from '@/utils/serializar';
import { listarCarpetasMaterial } from '../../autoria/servidor.mjs';
import { join } from 'node:path';
import { MODELO_PREGUNTAS } from '@/lib/crear/modelo';

// Herramienta de autoría: carga la pregunta y genera el JSON de la unidad para reemplazarlo.
const entradas = await getCollection('preguntas');
const bancos = entradas
  .map((entrada) => ({ archivo: `${entrada.id}.json`, banco: entrada.data }))
  .sort((a, b) => a.banco.unidad - b.banco.unidad);
const documentos = await obtenerDocumentosMaterial();
// Carpetas de unidad donde se puede subir un archivo desde la PC (en el build no se usan).
const carpetas = await listarCarpetasMaterial(join(process.cwd(), 'materialEstudio'));
const idsExistentes = bancos.flatMap(({ banco }) => banco.preguntas.map((p) => p.id));

const clasesInput =
  'mt-1 w-full border-[3px] border-borde bg-panel px-3 py-2 text-sm text-tinta placeholder:text-tenue focus:outline-none focus:bg-panel-2';
const clasesEtiqueta = 'block text-sm font-bold text-tinta';
const clasesAyuda = 'mt-1 block text-xs text-tenue';
const clasesSeccion = 'caja-pixel bg-panel p-5 sm:p-6';
---

<BaseLayout title="Crear pregunta · Quiz BDD">
  <main class="mx-auto max-w-3xl px-4 py-6 sm:px-6 sm:py-10">
    <VolverInicio />

    <CabeceraPagina titulo="Crear pregunta">
      <span class="font-bold text-sql-clave">INSERT INTO</span>{' '}<span class="text-sql-funcion">banco</span>{' ...;'}
      <Fragment slot="descripcion">
        Completá el formulario, revisá la vista previa y descargá el archivo de la unidad ya actualizado.
        Después reemplazalo en <code class="text-sql-cadena">src/content/preguntas/</code>.
      </Fragment>
    </CabeceraPagina>

    <!-- Modo edición: aparece cuando la pregunta se abre desde la lista de Preguntas. -->
    <div id="aviso-edicion" class="caja-pixel mt-6 hidden bg-aviso-suave p-4 text-sm text-tinta" role="status">
      <p>
        Editando <code id="id-en-edicion" class="text-sql-clave"></code>. Al guardar, la pregunta se reemplaza en el banco.
      </p>
    </div>
    <p class="mt-4 text-sm">
      <a href="/preguntas/" class="font-bold text-primario underline underline-offset-4">Ver las preguntas existentes →</a>
    </p>

    <form id="formulario-pregunta" class="mt-8 flex flex-col gap-6" novalidate>
      <!-- Unidad e identificador -->
      <section class={clasesSeccion} aria-labelledby="t-unidad">
        <h2 id="t-unidad" class="text-xl font-bold text-tinta">1. Unidad</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="campo-unidad" class={clasesEtiqueta}>Unidad</label>
            <select id="campo-unidad" class={clasesInput}>
              {
                bancos.map(({ banco }) => (
                  <option value={banco.unidad}>
                    Unidad {banco.unidad} · {banco.titulo}
                  </option>
                ))
              }
            </select>
          </div>
          <label class={clasesEtiqueta}>
            Identificador
            <input id="campo-id" class={clasesInput} type="text" autocomplete="off" placeholder="u05-nueva-pregunta" />
            <span class={clasesAyuda}>Se sugiere a partir del tema. Solo minúsculas, números y guiones.</span>
          </label>
        </div>
        <label class={`${clasesEtiqueta} mt-4`}>
          Tema
          <input id="campo-tema" class={clasesInput} type="text" placeholder="Ej.: Subconsulta escalar" />
        </label>
      </section>

      <!-- Enunciado y opciones -->
      <section class={clasesSeccion} aria-labelledby="t-enunciado">
        <h2 id="t-enunciado" class="text-xl font-bold text-tinta">2. Pregunta y opciones</h2>
        <label class={`${clasesEtiqueta} mt-4`}>
          Enunciado
          <textarea id="campo-enunciado" class={clasesInput} rows="3" placeholder="¿Qué devuelve una subconsulta escalar?"></textarea>
        </label>

        <div class="mt-6">
          <label for="campo-cantidad" class={clasesEtiqueta}>Cantidad de opciones</label>
          <select id="campo-cantidad" class={`${clasesInput} sm:w-48`}>
            <option value="2">2 opciones</option>
            <option value="3">3 opciones</option>
            <option value="4" selected>4 opciones</option>
          </select>
        </div>

        <fieldset class="mt-4 flex flex-col gap-4">
          <legend class="text-sm font-bold text-tinta">Opciones (marcá la correcta)</legend>
          {
            ['a', 'b', 'c', 'd'].map((letra, indice) => (
              <div class="border-[3px] border-borde bg-panel-2 p-4" data-bloque-opcion={indice + 1}>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <input
                    type="radio"
                    name="respuesta"
                    value={letra}
                    id={`respuesta-${letra}`}
                    class="size-4 shrink-0 accent-ok"
                  />
                  <label for={`respuesta-${letra}`} class="whitespace-nowrap font-pixel text-lg font-bold uppercase text-tinta">
                    Opción {letra.toUpperCase()}
                  </label>
                  <span class="text-xs text-tenue">marcar si es la correcta</span>
                </div>
                <label class={`${clasesEtiqueta} mt-3`}>
                  Texto de la opción
                  <input id={`opcion-${letra}-texto`} class={clasesInput} type="text" />
                </label>
                <label class={`${clasesEtiqueta} mt-3`}>
                  Por qué es correcta o incorrecta
                  <textarea id={`opcion-${letra}-explicacion`} class={clasesInput} rows="2"></textarea>
                </label>
              </div>
            ))
          }
        </fieldset>
      </section>

      <!-- Explicación y resumen -->
      <section class={clasesSeccion} aria-labelledby="t-explicacion">
        <h2 id="t-explicacion" class="text-xl font-bold text-tinta">3. Explicación <span class="font-sans text-sm font-normal text-tenue">(opcional)</span></h2>
        <label class={`${clasesEtiqueta} mt-4`}>
          Explicación general del concepto <span class="font-normal text-tenue">(opcional)</span>
          <textarea id="campo-explicacion" class={clasesInput} rows="3"></textarea>
        </label>
        <label class={`${clasesEtiqueta} mt-4`}>
          Resumen <span class="font-normal text-tenue">(opcional)</span>
          <textarea id="campo-resumen" class={clasesInput} rows="2" placeholder="Idea breve para recordar el concepto."></textarea>
          <span class={clasesAyuda}>Se muestra al responder, dentro de la explicación de la pregunta.</span>
        </label>
      </section>

      <!-- Material de estudio -->
      <section class={clasesSeccion} aria-labelledby="t-material">
        <h2 id="t-material" class="text-xl font-bold text-tinta">4. Material de estudio <span class="font-sans text-sm font-normal text-tenue">(opcional)</span></h2>
        <p class="mt-2 text-sm text-tenue">
          Si querés que la pregunta enlace a un documento, elegí el documento y la sección (o la página, si es un PDF).
          El enlace se arma solo. Si no hace falta, dejá esta sección vacía.
        </p>

        <!-- Subida desde la PC: copia el archivo a materialEstudio/ (solo con npm run dev). -->
        <div class="mt-4 border-[3px] border-dashed border-borde/50 p-4">
          <p class="text-sm font-bold text-tinta">¿Querés usar un archivo de tu PC?</p>
          <p class={clasesAyuda}>
            Elegí la unidad donde se guarda y el archivo (PDF o HTML). Se copia a <code class="text-sql-cadena">materialEstudio/</code> y
            queda en la lista de documentos. Solo funciona con <code class="text-sql-cadena">npm run dev</code>.
          </p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <div>
              <label for="campo-carpeta-subida" class={clasesEtiqueta}>Guardar en</label>
              <select id="campo-carpeta-subida" class={clasesInput}>
                {carpetas.map((carpeta) => <option value={carpeta}>{carpeta}</option>)}
              </select>
            </div>
            <div>
              <label for="campo-archivo" class={clasesEtiqueta}>Archivo</label>
              <input id="campo-archivo" type="file" accept=".pdf,.html,application/pdf,text/html" class={clasesInput} />
            </div>
          </div>
          <button type="button" id="boton-subir" class="boton-pixel mt-3 bg-primario text-sobre-primario">⬆ Subir al material</button>
          <p id="estado-subida" class="mt-2 text-sm text-tenue" role="status"></p>
        </div>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="campo-documento" class={clasesEtiqueta}>Documento</label>
            <select id="campo-documento" class={clasesInput}>
              <option value="">— Elegí un documento —</option>
              {
                documentos.map((doc) => (
                  <option value={doc.ruta} data-titulo={doc.titulo}>
                    {doc.titulo}
                  </option>
                ))
              }
            </select>
          </div>
          <div id="bloque-seccion">
            <label for="campo-seccion" class={clasesEtiqueta}>Sección</label>
            <select id="campo-seccion" class={clasesInput} disabled>
              <option value="">— Primero elegí un documento —</option>
            </select>
          </div>
        </div>
        <!-- Para un PDF se indica la página en lugar de una sección. -->
        <label id="bloque-pagina" class={`${clasesEtiqueta} mt-4 hidden`}>
          Página del PDF
          <input id="campo-pagina" class={clasesInput} type="number" min="1" step="1" placeholder="Ej.: 3" />
          <span class={clasesAyuda}>El enlace abre el PDF en esa página.</span>
        </label>
        <label class={`${clasesEtiqueta} mt-4`}>
          Nombre que verá quien estudie
          <input id="campo-titulo-material" class={clasesInput} type="text" />
        </label>
        <button type="button" id="boton-agregar-material" class="boton-pixel mt-4 bg-acento text-sobre-acento">
          + Agregar material
        </button>
        <ul id="lista-material" class="mt-4 flex flex-col gap-2" aria-live="polite"></ul>
      </section>

      <!-- Acciones -->
      <section class={clasesSeccion} aria-labelledby="t-acciones">
        <h2 id="t-acciones" class="text-xl font-bold text-tinta">5. Vista previa y guardado</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <button type="button" id="boton-vista-previa" class="boton-pixel bg-panel-2 text-tinta">👁 Vista previa</button>
          <button type="button" id="boton-guardar-banco" class="boton-pixel bg-primario text-sobre-primario">💾 Guardar en el banco</button>
          <button type="button" id="boton-descargar" class="boton-pixel bg-panel-2 text-tinta">⬇ Descargar JSON de la unidad</button>
          <button type="button" id="boton-copiar" class="boton-pixel bg-panel-2 text-tinta">⧉ Copiar solo la pregunta</button>
          <button type="button" id="boton-limpiar" class="boton-pixel bg-panel-2 text-tenue">Limpiar</button>
        </div>

        <div id="mensaje-estado" class="mt-4 text-sm" role="status" aria-live="polite"></div>
        <ul id="lista-errores" class="mt-2 flex flex-col gap-1 text-sm text-error" aria-live="assertive"></ul>
        <pre id="vista-previa" class="mt-4 hidden max-h-96 overflow-auto border-[3px] border-borde bg-panel-2 p-4 text-xs text-tinta"></pre>
      </section>

      <!-- Importar un JSON con preguntas ya armadas (por ejemplo, a partir de un PDF) -->
      <section class={clasesSeccion} aria-labelledby="t-importar">
        <h2 id="t-importar" class="text-xl font-bold text-tinta">6. Importar preguntas desde un JSON</h2>
        <p class="mt-2 text-sm text-tenue">
          Si ya tenés las preguntas armadas en un JSON, subilo acá: se revisa con las mismas reglas del banco y, si está bien,
          se agregan a la unidad elegida en el paso 1. Solo funciona con <code class="text-sql-cadena">npm run dev</code>.
        </p>

        <div class="mt-4 flex flex-wrap gap-3">
          <button type="button" id="boton-descargar-modelo" class="boton-pixel bg-panel-2 text-tinta">⬇ Descargar modelo</button>
        </div>

        <details class="mt-4 border-[3px] border-borde bg-panel-2 p-3">
          <summary class="cursor-pointer text-sm font-bold text-primario">Ver el modelo completo</summary>
          <p class="mt-3 text-xs text-tenue">
            Las reglas: de 2 a 4 opciones (a, b, c, d en ese orden), una respuesta correcta que sea una de ellas, y ids únicos.
            La explicación general, el resumen y el material son opcionales. Un material puede ser un HTML del material
            (con <code>seccion</code> = id de una sección) o un PDF (con <code>seccion</code> = <code>pagina-N</code>).
          </p>
          <pre id="modelo-json" class="mt-3 max-h-96 overflow-auto text-xs text-tinta">{JSON.stringify(MODELO_PREGUNTAS, null, 2)}</pre>
        </details>

        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <div>
            <label for="campo-json" class={clasesEtiqueta}>Archivo JSON</label>
            <input id="campo-json" type="file" accept=".json,application/json" class={clasesInput} />
          </div>
        </div>
        <button type="button" id="boton-importar" class="boton-pixel mt-4 bg-acento text-sobre-acento">⬆ Importar a la unidad elegida</button>
        <p id="estado-importacion" class="mt-2 text-sm text-tenue" role="status"></p>
        <ul id="lista-importacion" class="mt-2 flex flex-col gap-1 text-sm text-error"></ul>
      </section>
    </form>

    <script
      is:inline
      type="application/json"
      id="datos-crear"
      set:html={serializarParaScript({ bancos, documentos, idsExistentes })}
    ></script>
  </main>
</BaseLayout>

<script>
  import { iniciarCrear } from '@/scripts/crear';
  iniciarCrear();
</script>
