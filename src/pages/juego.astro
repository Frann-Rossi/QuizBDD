---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Juego from '@/components/Juego.astro';
import CabeceraPagina from '@/components/CabeceraPagina.astro';
import VolverInicio from '@/components/VolverInicio.astro';
import { aPreguntasCuestionario } from '@/lib/quiz/cuestionario';
import { obtenerBancosPreguntas } from '@/services/preguntas';

const bancos = await obtenerBancosPreguntas();
const preguntas = bancos.flatMap(aPreguntasCuestionario);
const unidades = bancos.map((banco) => ({
  unidad: banco.unidad,
  titulo: banco.titulo,
  cantidad: banco.preguntas.length,
}));
---

<BaseLayout title="Modo juego · Quiz BDD" description="Jugá en grupo: cada jugador vota su respuesta y se revela quién acertó.">
  <main class="mx-auto max-w-3xl px-4 py-6 sm:px-6 sm:py-10">
    <VolverInicio />

    <CabeceraPagina titulo="Modo juego">
      <span class="font-bold text-sql-clave">CREATE TABLE</span>{' partida (jugadores '}<span class="text-sql-funcion">INT</span>);
      <Fragment slot="descripcion">
        Votación en este mismo dispositivo: cada jugador toca su nombre en la opción que elige, y se ve quién votó
        cada respuesta. Cuando votaron todos, se revela quién acertó.
      </Fragment>
    </CabeceraPagina>

    <Juego preguntas={preguntas} unidades={unidades} />
  </main>
</BaseLayout>
